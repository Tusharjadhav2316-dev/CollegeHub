# ====================================================
# DATABASE (NEON POSTGRESQL)
# ====================================================
# The connection string for the PostgreSQL database hosted on Neon.
DATABASE_URL=""

# ====================================================
# NEXTAUTH
# ====================================================
# A 32-character random string used to sign NextAuth JWTs.
NEXTAUTH_SECRET=""
# The base URL of the application.
NEXTAUTH_URL="http://localhost:3000"

# ====================================================
# GOOGLE OAUTH
# ====================================================
# Google Developer Console OAuth Client ID.
GOOGLE_CLIENT_ID=""
# Google Developer Console OAuth Client Secret.
GOOGLE_CLIENT_SECRET=""

# ====================================================
# GITHUB OAUTH
# ====================================================
# GitHub Developer Settings OAuth Client ID.
GITHUB_CLIENT_ID=""
# GitHub Developer Settings OAuth Client Secret.
GITHUB_CLIENT_SECRET=""

# ====================================================
# OPTIONAL COLLEGE API
# ====================================================
# Optional third-party API key for fetching/syncing college data.
COLLEGE_API_KEY=""

# ====================================================
# APPLICATION
# ====================================================
# The display name of the application.
APP_NAME="CampusPilot"
# The public URL of the application.
APP_URL="http://localhost:3000"
# The Node environment (development, production, test).
NODE_ENV="development"
